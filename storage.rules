rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function imageType(){return request.resource.contentType in ['image/jpeg','image/png','image/webp'];}
  match /listingPhotos/{uid}/{file} {
   allow read: if true;
   allow write: if request.auth != null && request.auth.uid == uid
    && request.resource.size <= 5 * 1024 * 1024 && imageType();
  }
  match /profiles/{uid}/{file} {
   allow read: if true;
   allow write: if request.auth != null && request.auth.uid == uid
    && request.resource.size <= 3 * 1024 * 1024 && imageType();
  }
 }
}